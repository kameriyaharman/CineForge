# ---- Required ----
DATABASE_URL=postgresql://user:password@host:5432/cineforge   # Railway: ${{Postgres.DATABASE_URL}}
FAL_KEY=                          # fal.ai API key (server only)
SESSION_SECRET=                   # long random string: openssl rand -base64 48

# Temporary stand-in for login: a users.id UUID. Baked in at build time.
NEXT_PUBLIC_CINEFORGE_USER_ID=

# ---- Optional ----
MAGNIFIC_API_KEY=                 # enables the automatic upscale after each render
MAGNIFIC_RESOLUTION=4k            # 720p | 1k | 2k | 4k (default 4k; billed per frame)
REPLICATE_API_TOKEN=              # Budget model + Budget prompt edit (FLUX.2 Klein on Replicate)

# Interim owner sign-in at /login (16+ characters)
OWNER_ACCESS_KEY=
OWNER_EMAIL=
