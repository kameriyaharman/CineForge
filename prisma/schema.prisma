// CineForge — PostgreSQL schema (Prisma ORM 7)
// Connection URL lives in prisma.config.ts (Prisma 7 no longer reads it from here).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------- Enums ----------------------------------

enum ClipStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AssetKind {
  IMAGE
  VIDEO
}

/// Where an asset came from in the pipeline.
enum AssetRole {
  RENDER
  UPSCALE
  IMAGE
  UPLOAD
}

/// Lifecycle of the Soul ID face embedding extracted via IP-Adapter-FaceID.
enum FaceIdStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Soul ID training lifecycle (LoRA trained on the hero's photos).
enum SoulStatus {
  NONE
  TRAINING
  READY
  FAILED
}

// ---------------------------------- Models ----------------------------------

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(320)
  name      String?  @db.VarChar(120)
  /// When on, nothing is sent to Fal: the app returns sample results for free.
  testMode        Boolean  @default(true) @map("test_mode")
  /// Paid work stops once this month's estimated spend would pass this (USD). Null = no limit.
  monthlyLimitUsd Float?   @map("monthly_limit_usd")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  characters       Character[]
  projects         Project[]
  assets           Asset[]
  imageGenerations ImageGeneration[]
  spend            SpendLog[]

  @@map("users")
}

/// A "Soul ID" hero character: the reference sheet used to keep a face
/// consistent across every clip it appears in.
model Character {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  characterName      String       @map("character_name") @db.VarChar(80)
  referenceImageUrl  String       @map("reference_image_url") @db.Text
  /// Content type, byte size, host etc. captured at registration.
  referenceImageMeta Json?        @map("reference_image_meta")
  /// Face embedding(s) returned by IP-Adapter-FaceID. Null until extracted.
  faceIdVectors      Json?        @map("face_id_vectors")
  faceIdStatus       FaceIdStatus @default(PENDING) @map("face_id_status")
  /// Pinned Replicate model version used to produce faceIdVectors.
  faceIdModelVersion String?      @map("face_id_model_version") @db.VarChar(128)
  faceIdError        String?      @map("face_id_error") @db.Text

  /// Soul ID: identity trained from uploaded photos.
  soulStatus         SoulStatus   @default(NONE) @map("soul_status")
  /// Training preset chosen by the user (see lib/soul-options.ts).
  soulPreset         String?      @map("soul_preset") @db.VarChar(30)
  /// Rare token the LoRA was trained on; put in prompts to call the face.
  triggerWord        String?      @map("trigger_word") @db.VarChar(40)
  /// Trained LoRA weights, copied into our bucket.
  loraKey            String?      @map("lora_key") @db.Text
  trainingRequestId  String?      @map("training_request_id") @db.VarChar(128)
  trainingError      String?      @map("training_error") @db.Text
  trainingStartedAt  DateTime?    @map("training_started_at") @db.Timestamptz(3)
  trainingFinishedAt DateTime?    @map("training_finished_at") @db.Timestamptz(3)

  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoClips       VideoClip[]
  photos           CharacterPhoto[]
  imageGenerations ImageGeneration[]

  @@unique([userId, characterName])
  @@index([userId, createdAt(sort: Desc)])
  @@index([trainingRequestId])
  @@map("characters")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(160)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoClips VideoClip[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("projects")
}

model VideoClip {
  id                String     @id @default(uuid()) @db.Uuid
  projectId         String     @map("project_id") @db.Uuid
  /// Optional: a clip can be rendered without a Soul ID character.
  characterId       String?    @map("character_id") @db.Uuid
  prompt            String     @db.Text
  cameraMovement    String?    @map("camera_movement") @db.VarChar(40)
  /// Render settings chosen on the dashboard.
  resolution        String?    @db.VarChar(10)
  numFrames         Int?       @map("num_frames")
  aspectRatio       String?    @map("aspect_ratio") @db.VarChar(10)
  rawVideoUrl       String?    @map("raw_video_url") @db.Text
  upscaledVideoUrl  String?    @map("upscaled_video_url") @db.Text
  status            ClipStatus @default(PENDING)
  /// Fal / Replicate job id, used to match incoming webhooks to this row.
  providerRequestId String?    @unique @map("provider_request_id") @db.VarChar(128)
  seed              Int?
  errorMessage      String?    @map("error_message") @db.Text
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  assets    Asset[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([characterId])
  @@index([status])
  @@map("video_clips")
}

/// A file kept permanently in the CineForge bucket (provider links expire).
model Asset {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// The render this file belongs to, if any.
  clipId      String?   @map("clip_id") @db.Uuid
  /// The Image Studio run this file came from, if any.
  generationId String?  @map("generation_id") @db.Uuid
  kind        AssetKind
  role        AssetRole
  storageKey  String    @unique @map("storage_key") @db.Text
  contentType String    @map("content_type") @db.VarChar(100)
  byteSize    BigInt?   @map("byte_size")
  /// Provider URL the file was copied from.
  sourceUrl   String?   @map("source_url") @db.Text
  prompt      String?   @db.Text
  /// Settings used to make it (resolution, frames, aspect ratio, model…).
  meta        Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip       VideoClip?       @relation(fields: [clipId], references: [id], onDelete: SetNull)
  generation ImageGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@unique([clipId, role])
  @@index([userId, createdAt(sort: Desc)])
  @@index([generationId])
  @@map("assets")
}

/// One Image Studio run: a prompt sent to a text-to-image model for 1–4 images.
model ImageGeneration {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  /// CineForge model id (see lib/image-models.ts), not the Fal endpoint.
  model             String     @db.VarChar(60)
  /// What the user typed.
  prompt            String     @db.Text
  /// What was sent to the model (prompt + style preset).
  finalPrompt       String     @map("final_prompt") @db.Text
  stylePreset       String?    @map("style_preset") @db.VarChar(40)
  aspectRatio       String     @map("aspect_ratio") @db.VarChar(10)
  quality           String?    @db.VarChar(10)
  numImages         Int        @map("num_images")
  seed              Int?
  status            ClipStatus @default(PROCESSING)
  providerRequestId String?    @unique @map("provider_request_id") @db.VarChar(128)
  /// Soul ID hero whose trained face was used, if any.
  characterId       String?    @map("character_id") @db.Uuid
  /// LoRA strength used with the Soul ID.
  loraScale         Float?     @map("lora_scale")
  /// Edits: the Library image that was edited / upscaled.
  sourceAssetId     String?    @map("source_asset_id") @db.Uuid
  /// Provider output: [{ url, width, height, contentType }]
  outputs           Json?
  errorMessage      String?    @map("error_message") @db.Text
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  assets    Asset[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([characterId])
  @@map("image_generations")
}

/// A training photo of a Soul ID hero, stored privately in the bucket.
model CharacterPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  characterId String   @map("character_id") @db.Uuid
  storageKey  String   @unique @map("storage_key") @db.Text
  contentType String   @map("content_type") @db.VarChar(100)
  byteSize    BigInt?  @map("byte_size")
  fileName    String?  @map("file_name") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt])
  @@map("character_photos")
}

/// Estimated provider cost of each paid request, for the spend meter and monthly limit.
model SpendLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// IMAGE | VIDEO | TRAINING
  kind        String   @db.VarChar(20)
  /// Generation, clip or character id.
  refId       String?  @map("ref_id") @db.Uuid
  amountUsd   Float    @map("amount_usd")
  description String   @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("spend_log")
}
